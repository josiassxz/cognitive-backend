# TLS automático (Let's Encrypt) quando SITE_ADDRESS é um domínio público apontado para a VPS.
# Para teste local sem domínio: SITE_ADDRESS=:80 (HTTP puro) e COOKIE_SECURE=false.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Upload de livros (import-book) usa até 50 MB; pacotes de conteúdo até 64 MB.
	request_body {
		max_size 70MB
	}

	@backend path /api/* /media/* /health
	handle @backend {
		reverse_proxy api:3333 {
			# streaming de áudio com Range: sem buffer de resposta
			flush_interval -1
		}
	}

	handle {
		root * /srv/web
		# rotas internas do app (reload em /reading/12/study) caem no index.html
		try_files {path} /index.html
		file_server
		@assets path /_expo/* /assets/* /icons/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
