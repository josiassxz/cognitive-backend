# Copie para deploy/.env e preencha. NUNCA versione o .env real.

# --- endereço público -------------------------------------------------------
SITE_ADDRESS=app.DOMINIO_A_DEFINIR            # domínio apontado (DNS A/AAAA) para a VPS
CORS_ORIGINS=https://app.DOMINIO_A_DEFINIR
PUBLIC_BASE_URL=                              # vazio = mesma origem (recomendado)

# --- segredos (gere com: openssl rand -hex 32) ------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEDIA_URL_SECRET=
IMPORT_API_TOKEN=                             # token do worker local (mín. 32 caracteres)

# --- dados persistentes ------------------------------------------------------
MEDIA_DIR=/srv/tunely/media                   # pasta no servidor com reading/, reading-lab/…
POSTGRES_DB=tunely
POSTGRES_USER=tunely
STORAGE_DRIVER=filesystem                     # ou s3 (exige AWS_* abaixo)

# --- administração -----------------------------------------------------------
ADMIN_EMAILS=                                 # e-mails com papel admin, separados por vírgula
COOKIE_SECURE=true

# --- opcionais (recursos que dependem de terceiros) --------------------------
DEEPL_API_KEY=
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# opcional: cache npm local para o build da imagem (só se a rede do Docker travar)
NPM_CACHE_DIR=
