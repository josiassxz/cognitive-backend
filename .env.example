# Backend — copie para .env. Sem segredos reais aqui.
NODE_ENV=development
PORT=3333
JWT_SECRET=
JWT_REFRESH_SECRET=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cognitive

# Storage: filesystem (padrão sem credenciais AWS) ou s3
STORAGE_DRIVER=filesystem
MEDIA_ROOT=./data/media
PUBLIC_BASE_URL=
MEDIA_URL_SECRET=
MEDIA_URL_TTL_SECONDS=21600

CORS_ORIGINS=http://localhost:8081
ADMIN_EMAILS=
IMPORT_API_TOKEN=
COOKIE_SECURE=false

# Opcionais — cada recurso responde com erro localizado se a chave faltar
DEEPL_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
