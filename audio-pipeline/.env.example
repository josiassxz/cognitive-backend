# Worker local — copie para audio-pipeline/.env. Sem segredos reais aqui.
PROCESSING_ROOT=                 # padrão: audio-pipeline/processing
ASR_ENGINE=mlx
ASR_MODEL=mlx-community/whisper-large-v3-turbo
ALIGNMENT_ENGINE=whisperx
PIPELINE_WORKERS=1

# Tradução (só no worker; nunca no app)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
TRANSLATION_BUDGET_LIMIT=        # teto em US$ por execução de `pipeline translate`

# Importação no backend
PIPELINE_API_URL=http://localhost:3333/api/admin
PIPELINE_IMPORT_TOKEN=           # mesmo valor de IMPORT_API_TOKEN do backend
MEDIA_ROOT=                      # raiz local da mídia para conferir hash/duração
